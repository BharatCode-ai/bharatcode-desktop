#!/usr/bin/env bash

set -euo pipefail
if [ "$#" -ne 3 ] || [[ ! "$2" =~ ^[a-f0-9]{40}$ ]] || [[ "$3" != beta && "$3" != prod ]]; then
  echo "Usage: script/release <remote-branch-or-tag> <exact-committed-source-sha> <beta|prod>" >&2
  echo "Builds a candidate only. Does not publish or promote a release." >&2
  exit 2
fi
gh workflow run publish.yml --repo BharatCode-ai/bharatcode-desktop --ref "$1" -f source_sha="$2" -f channel="$3"
